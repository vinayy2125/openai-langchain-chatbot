# Web Scraper Configuration
SCRAPER_BASE_URLS=https://example.com
SCRAPER_MAX_DEPTH=3
SCRAPER_MAX_PAGES=100
SCRAPER_RATE_LIMIT=1.0
SCRAPER_BATCH_SIZE=5                 # Pages to process concurrently
SCRAPER_BATCH_DELAY=2.0              # Delay between batches (seconds)
SCRAPER_OUTPUT_DIR=./scraped_data
SCRAPER_LOG_FILE=./scraped_data/scraper.log
SCRAPER_DETAILED_LOGGING=true
SCRAPER_HEADLESS=true
SCRAPER_CHUNK_SIZE=500
SCRAPER_HEADLESS=true
SCRAPER_CHUNK_SIZE=500

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
CHROMA_COLLECTION_NAME=website_embeddings
# Set CHROMA_SERVER_URL to use HttpClient (production) instead of PersistentClient (dev)
# When running with docker-compose, use: http://chromadb:8000
# When running locally with separate ChromaDB server: http://localhost:8001
CHROMA_SERVER_URL=
CHROMA_USE_HTTP_CLIENT=false

# Scheduler Configuration
SCRAPER_SCHEDULE_DAY=sun
SCRAPER_SCHEDULE_HOUR=2